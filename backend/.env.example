# =====================================
# MG APPSTORE BACKEND CONFIGURATION
# =====================================

# Server
PORT=5000

# Database
# Local testing के लिए SQLite इस्तेमाल होगा।
DATABASE_URL=sqlite:///mg_appstore.db

# Production में Render PostgreSQL URL डालें।
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE

# Security
# Production में दोनों के लिए अलग-अलग मजबूत Random Secrets रखें।
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# Admin Account
ADMIN_NAME=MG AppStore Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
